# Copy to .env.local and adjust. (.env.local is gitignored.)

# Dev only — omit or leave unset: mock API is the default while `npm run dev`
# VITE_USE_MOCK_API=true

# Force pain-server in dev (backend on :3000, then npm run dev:pain-server)
# VITE_USE_MOCK_API=false

# Production `npm run build` uses pain-server unless you set VITE_USE_MOCK_API=true

# Optional absolute API origin for production/staging (no trailing slash).
# Leave empty when the static site and pain-server share the same host.
# VITE_PAIN_API_BASE=

# Vite dev proxy target for pain-server when VITE_USE_MOCK_API=false (see vite.config.ts)
# PAIN_SERVER_PORT=3000

# Vite dev proxy target for local mock when VITE_USE_MOCK_API=true
# PAIN_API_PORT=3847
